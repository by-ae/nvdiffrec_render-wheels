# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote binary files
*.whl binary
*.so binary
*.pyd binary
*.dylib binary
*.dll binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
